{
  "name": "babylonjs-sample-app",
  "version": "1.0.0",
  "description": "A simple 3D application using Babylon.js",
  "main": "dist/app.js",
  "scripts": {
    "build": "npx esbuild src/app.ts --bundle --outfile=dist/app.js",
    "start": "npx esbuild src/app.ts --bundle --outfile=dist/app.js && npx http-server -c-1 -p 8080",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "babylonjs": "^9.30.0"
  },
  "devDependencies": {
    "@types/babylonjs": "^2.4.5",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2"
  }
}
